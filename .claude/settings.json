{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "g-inga@g-inga": false
  },
  "permissions": {
    "deny": [
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git commit -nm*)",
      "Bash(git commit * -nm*)",
      "Bash(HK=0 *)",
      "Bash(* HK=0 *)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config *core.hooksPath*)"
    ]
  }
}
