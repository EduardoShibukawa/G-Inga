[
  {
    "id": "WTC-01",
    "name": "Independent parallel tasks with isolated files",
    "category": "independent_parallel",
    "description": "Two workers modify completely different non-overlapping files in separate worktrees without index contention.",
    "worker_count": 2,
    "shared_directory": false,
    "lock_contention_expected_in_shared": true,
    "expected_result": "pass",
    "workers": [
      {
        "id": "worker-1",
        "branch": "worker/feat-docs-1",
        "file_changes": [
          { "path": "docs/guide1.md", "content": "# Guide 1\nContent from worker 1\n" }
        ],
        "command": "bun test --version"
      },
      {
        "id": "worker-2",
        "branch": "worker/feat-docs-2",
        "file_changes": [
          { "path": "docs/guide2.md", "content": "# Guide 2\nContent from worker 2\n" }
        ],
        "command": "bun test --version"
      }
    ]
  },
