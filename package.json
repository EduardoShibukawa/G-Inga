{
  "name": "g-inga-repo-tooling",
  "private": true,
  "description": "Development-only validation tooling for the G-Ingá repository. Not the product runtime.",
  "type": "module",
  "scripts": {
    "validate": "bun tools/validate/preflight.ts && bun tools/validate/main.ts",
    "validate:external": "bun tools/validate/preflight.ts && bun tools/validate/main.ts --external-only",
    "test": "bun tools/validate/preflight.ts && bun test tools/validate",
    "typecheck": "bun tools/validate/preflight.ts && tsc --noEmit -p tools/validate",
    "build:validator": "bun build tools/validate/standalone.ts --target=node --outfile tools/validate/validate.js",
    "build:contract-copy": "bun tools/validate/contract-copy.mjs",
    "manifest": "bun tools/validate/manifest.mjs"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@types/bun": "^1.4.2",
    "markdownlint": "^0.41.1",
    "puppeteer": "^25.13.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
